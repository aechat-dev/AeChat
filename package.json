{
  "name": "aechat",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Local-first session messaging service for multiple AI agents",
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
