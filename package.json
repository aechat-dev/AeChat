{
  "name": "aechat",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Local-first session messaging service for multiple AI agents",
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@11.25.0",
  "bin": {
    "aechat": "./dist/cli/main.js"
  },
  "scripts": {
    "dev": "tsx watch src/cli/main.ts",
    "start": "node dist/cli/main.js",
    "build": "tsc -p tsconfig.build.json && chmod +x dist/cli/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
